{
  "name": "memflow-electron",
  "version": "0.1.0",
  "description": "MemFlow desktop (Electron) — thin client with local review outbox",
  "private": true,
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "esbuild electron/main.ts electron/preload.ts --outdir=out --out-extension:.js=.cjs --format=cjs --platform=node --external:electron --external:better-sqlite3 --bundle --sourcemap",
    "build": "npm run build:main && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "rebuild:sqlite": "node-gyp rebuild --target=34.5.8 --arch=arm64 --dist-url=https://electronjs.org/headers --directory node_modules/better-sqlite3",
    "build:cli": "esbuild cli/bin/memflow.ts --bundle --platform=node --format=cjs --outfile=out/cli/memflow.cjs --external:better-sqlite3 --loader:.md=text --loader:.json=json",
    "test:m12": "esbuild scripts/test-m12.ts --bundle --platform=node --format=cjs --outfile=out/test/m12.cjs --external:better-sqlite3 --loader:.md=text && MEMFLOW_DATA_DIR=/private/tmp/memflow-m12-test node out/test/m12.cjs",
    "test:409": "esbuild scripts/test-409.ts --bundle --platform=node --format=cjs --outfile=out/test/409.cjs --external:better-sqlite3 --loader:.md=text && node out/test/409.cjs",
    "test:billing": "esbuild scripts/test-billing.ts --bundle --platform=node --format=cjs --outfile=out/test/billing.cjs --external:better-sqlite3 --loader:.md=text && node out/test/billing.cjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:market": "esbuild scripts/test-market.ts --bundle --platform=node --format=cjs --outfile=out/test/market.cjs --external:better-sqlite3 --loader:.md=text && node out/test/market.cjs",
    "test:prod": "node scripts/prod-smoke.mjs"
  },
  "dependencies": {
    "@nssai/scheduler": "^0.1.0",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "better-sqlite3": "^11.10.0",
    "cmdk": "^1.1.0",
    "katex": "^0.16.47",
    "qrcode": "^1.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/qrcode": "^1.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.1.2",
    "electron": "34.5.8",
    "electron-builder": "^25.0.0",
    "electron-rebuild": "^3.2.9",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.pangustudio.desktop",
    "productName": "MemFlow",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "dmg": {
      "artifactName": "MemFlow-${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "MemFlow-Setup-${version}-${arch}.exe"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Education"
    },
    "appImage": {
      "artifactName": "MemFlow-${version}-${arch}.AppImage"
    },
    "npmRebuild": false,
    "electronVersion": "34.5.8"
  }
}
